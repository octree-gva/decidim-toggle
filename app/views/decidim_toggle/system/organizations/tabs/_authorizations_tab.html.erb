<%# locals: (organization:, tab:) %>
<%= decidim_toggle_settings_tab_form(organization, tab) do |tf| %>
  <% tab_form = tf.object %>
  <fieldset>
    <legend class="form-legend"><%= t("decidim_toggle.system.organizations.authorizations_tab.legend") %></legend>
    <p class="text-sm text-gray-2 mb-4"><%= t("decidim_toggle.system.organizations.authorizations_tab.hint") %></p>
    <% if Decidim::Toggle.ephemeral_participation? %>
      <p class="text-sm text-gray-2 mb-4"><%= t("decidim_toggle.system.organizations.authorizations_tab.ephemeral_hint") %></p>
      <table class="table-fields table table-bordered max-w-[1/2]">
        <thead>
          <tr>
            <th><%= t("decidim_toggle.system.organizations.authorizations_tab.workflow") %></th>
            <th><%= t("decidim_toggle.system.organizations.authorizations_tab.enabled") %></th>
            <th><%= t("decidim_toggle.system.organizations.authorizations_tab.ephemeral") %></th>
          </tr>
        </thead>
        <tbody>
          <% tab_form.collection_for_available_authorizations.each do |name, description| %>
            <% workflow = Decidim::Verifications.find_workflow_manifest(name) %>
            <% next unless workflow %>
            <tr>
              <td><%= description %></td>
              <td><%= check_box_tag "organization[available_authorizations][]", workflow.name, Array(tab_form.available_authorizations).map(&:to_s).include?(workflow.name.to_s), id: "organization_available_authorizations_#{workflow.name}", class: "!m-0" %></td>
              <td><%= radio_button_tag "organization[ephemeral_participation_authorization]", workflow.name, tab_form.ephemeral_participation_authorization.to_s == workflow.name.to_s, id: "organization_ephemeral_participation_authorization_#{workflow.name}", class: "!m-0", disabled: !Decidim::Toggle::UpdateAuthorizationsForm.ephemerable_workflow?(workflow) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <%= tf.fields_for_names(:available_authorizations) %>
    <% end %>
  </fieldset>
<% end %>
