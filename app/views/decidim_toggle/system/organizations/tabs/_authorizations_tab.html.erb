<%# locals: (organization:, tab:) %>
<%= decidim_toggle_settings_tab_form(organization, tab) do |tf| %>
  <fieldset>
    <legend class="form-legend"><%= t("decidim_toggle.system.organizations.authorizations_tab.legend") %></legend>
    <p class="text-sm text-gray-2 mb-4"><%= t("decidim_toggle.system.organizations.authorizations_tab.hint") %></p>
    <%= tf.fields_for_names(:available_authorizations) %>

    <% if Decidim::Toggle.ephemeral_participation? %>
      <p class="text-sm text-gray-2 mb-4 mt-6">
        <%= t("decidim_toggle.system.organizations.authorizations_tab.ephemeral_hint") %>
      </p>
      <%= tf.fields_for_names(:ephemeral_participation_authorization) %>
    <% end %>
  </fieldset>
<% end %>
